SLACK_WEBHOOK_URL=https://hooks.slack.com/services/sampletoken
SLACK_ALERT_CHANNEL=balerica-alerts
SLACK_ALERTS_ENABLED=true
SLACK_ALERT_SEVERITY=ERROR

# JIRA — added for lesson 3; do not remove the Slack lines above
# Copy these VALUES into your EXISTING .env — do NOT `cp` this file over it,
# or you will erase your Slack settings. NEVER commit the real .env or share
# the token with Claude Code.
# JIRA_API_TOKEN must be a plain "Create API token" (NOT "with scopes");
# scoped tokens fail with 401 against your *.atlassian.net site URL.

JIRA_SITE_URL=https://YOUR-SITE.atlassian.net
JIRA_EMAIL=the-email-you-log-into-Atlassian-with@example.com
JIRA_API_TOKEN=paste-your-plain-api-token-here
JIRA_PROJECT_KEY=BAI
JIRA_ISSUE_TYPE=Task
JIRA_ENABLED=true
INCIDENT_STATE_DB=data/incident_state.db
